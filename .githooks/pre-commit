#!/bin/sh
#
# Validate YAML frontmatter on staged Markdown/MDX files.
#
# A frontmatter value containing an unquoted ": " is invalid YAML. When it
# fails to parse, Mintlify drops the page title and prints the raw frontmatter
# into the page body -- catching it here keeps that off the live site.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
# or run:
#     scripts/setup-hooks.sh
#
# Bypass for a single commit with:  git commit --no-verify
#
set -eu

root=$(git rev-parse --show-toplevel)
exec python3 "$root/scripts/check_frontmatter.py" --staged